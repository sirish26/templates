# Example environment variables for local development and preview
# Copy this to `.env.local` and fill values before running the app.

# Public store hostname used for storefront preview
NEXT_PUBLIC_SHOPIFY_STORE=your-shop.myshopify.com

# Private API credentials (do NOT commit real secrets)
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SHOPIFY_API_SCOPES=read_products,write_products
